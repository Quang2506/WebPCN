                </div>
                </div>

                <div class="card">
                    <h2 class="card-title">Attachments</h2>

                    <!-- ✅ UPDATED: Hiển thị Existing files theo cùng layout với upload list -->
                    @if (ViewBag.AttFiles != null && ((IEnumerable<KeyValuePair<string, string>>)ViewBag.AttFiles).Any())
                    {
