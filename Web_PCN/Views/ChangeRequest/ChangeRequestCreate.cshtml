                    @*
                    @if (ViewBag.AttFiles != null && ((IEnumerable<KeyValuePair<string, string>>)ViewBag.AttFiles).Any())
                    {
                        <div style="margin:6px 0 12px">
                            <div style="font-weight:700; margin-bottom:6px">
