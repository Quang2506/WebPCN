                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="var(--ico-emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M19 21H5a2 2 0 0 1-2-2V7l4-4h10l4 4v12a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <rect x="7" y="3" width="10" height="6"></rect>
                            </svg>
                            Save
                        </button>

                        <button type="button" class="btn  btn-outline ClassDisabled"  id="btnDeleteDisabled">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="var(--ico-rose)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                <path d="M10 11v6M14 11v6"></path>
                                <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
                            </svg>
