@model Core.Dtos.ChangeRequests
@{
    ViewBag.Title = "ChangeRequestCreate";

    // Is new request (chưa có id)
    var isNew = string.IsNullOrWhiteSpace(Model?.requestid);

    // KHÔNG đụng tới Model.status để khỏi cần sửa DTO.
    int status = 0;
    try { status = (int)(ViewBag.Status ?? 0); } catch { status = 0; }

    // ✅ Nếu là tạo mới thì luôn coi là draft -> mở khóa nhập liệu
    if (isNew) { status = 1; }

    // Khóa input chỉ khi KHÔNG phải bản mới và status != 1
    var isLocked = !isNew && status != 1;

    // Flag để dùng cho disabled các nút
    var isDraft = status == 1;
}

@section Styles {
    <link rel="stylesheet" href="~/Content/changerequest.css" />
    <style>
        :root {
            --card-pad: 12px;
            --gap-x: 12px;
            --gap-y: 10px;
            --field-gap: 6px;
            --control-h: 40px;
            --radius: 10px;
            --textarea-min-h: 120px;
            --border: #d9dee8;
            /* Chủ đạo xanh dương */
            --blue1: #3b82f6;
            --blue2: #2563eb;
            /* Màu icon ngữ nghĩa */
            --ico-slate: #475569; /* cancel */
            --ico-amber: #f59e0b; /* edit */
            --ico-emerald: #10b981; /* save */
            --ico-rose: #ef4444; /* delete */
            --ico-indigo: #6366f1; /* submit / upload */
        }

        html, body {
            height: auto !important;
            min-height: 100% !important;
            overflow-x: hidden !important;
            overflow-y: auto !important;
            background: #f3f4f6;
            scrollbar-gutter: stable;
        }

        body {
            scrollbar-width: thin;
            scrollbar-color: #c7d2fe #eef2ff;
        }

            body::-webkit-scrollbar {
                width: 10px;
            }

            body::-webkit-scrollbar-thumb {
                background: #c7d2fe;
                border-radius: 8px;
            }

            body::-webkit-scrollbar-track {
                background: #eef2ff;
            }

        .page {
            max-width: 100%;
            /* margin: 10px auto 24px; */
            /* padding: 0 16px 48px; */
            /* margin-left: 25px; */
            margin: auto;
            width: 79%;
            padding: 0 !important;
            overflow-y: auto;
            height: 100%;
        }

        .top-actions {
            position: sticky;
            top: 0;
            z-index: 5;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 8px;
            padding: 8px 0 0;
            background: linear-gradient(to bottom, #f3f4f6 70%, rgba(243, 244, 246, 0));
            width: 97%;
            margin: auto;
        }
        /* ===== Buttons: tất cả xanh dương ===== */
        .btn {
            --btn-bg: linear-gradient(180deg,var(--blue1),var(--blue2));
            --btn-color: #fff;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid rgba(37,99,235,.35);
            border-radius: 10px;
            padding: 9px 14px;
            font-weight: 700;
            background: var(--btn-bg);
            color: var(--btn-color);
            cursor: pointer;
            transition: transform .12s, box-shadow .18s, opacity .18s, filter .18s;
        }

            .btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(31,42,55,.10);
                
            }



        .btn-outline {
            --btn-bg: #fff;
            color: var(--blue2);
            border: 1px solid rgba(37,99,235,.45);
            background: var(--btn-bg);
        }

        .btn-ghost {
            --btn-bg: rgba(37,99,235,.10);
            color: var(--blue2);
            border: 1px solid rgba(37,99,235,.20);
            background: var(--btn-bg);
        }

        .btn-disabled, .btn[disabled] {
            opacity: .55 !important;
            cursor: not-allowed !important;
            filter: grayscale(.2) saturate(.6);
            box-shadow: none !important;
            transform: none !important;
        }


        .ClassDisabled {
            cursor: not-allowed !important;
        }
        .btn.active.focus, .btn.active:focus, .btn.focus, .btn:active.focus, .btn:active:focus, .btn:focus {
            outline: none;
            outline-offset: -2px;
        }

        .btn .ico {
            width: 18px;
            height: 18px;
            display: inline-block;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
            margin-top: 6px;
            width: 97%;
            margin: 10px auto;
        }

        .card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: var(--card-pad);
            box-shadow: 0 4px 14px rgba(31,42,55,.06);
        }

        .card-title {
            font-weight: 700;
            font-size: 16px;
            margin: 2px 0 10px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(220px,1fr));
            column-gap: var(--gap-x);
            row-gap: var(--gap-y);
        }

            .form-grid .full {
                grid-column: 1/-1;
            }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: var(--field-gap);
        }

            .form-group label {
                font-size: 11.5px;
                color: #6b7788;
                font-weight: 600;
            }

            .form-control, .form-group input[type=text], .form-group select {
                height: var(--control-h);
                padding: 0 10px;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                background: #f7f9fc;
                color: #1f2a37;
            }

            .form-group textarea {
                min-height: var(--textarea-min-h);
                padding: 8px 10px;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                background: #f7f9fc;
                color: #1f2a37;
                resize: vertical;
            }

        input[readonly], textarea[readonly] {
            background: #f7f9fc !important;
            color: #1f2a37 !important;
            opacity: 1 !important;
            cursor: not-allowed;
        }

        .dropzone {
            border: 2px dashed #cad3e1;
            border-radius: 12px;
            padding: 16px;
            background: linear-gradient(180deg,#fbfdff 0%,#f6f9ff 100%);
            text-align: center;
            color: #7c8799;
        }

            .dropzone.disabled {
                opacity: .6;
                pointer-events: none;
                filter: grayscale(.3);
            }

        /* ================================
           ✅ UPDATED: dùng .file-list cho cả existing & upload list
           (trước đây chỉ style #fileList)
        ==================================*/
        .file-list {
            list-style: none;
            margin: 12px 0 0;
            padding: 0;
            text-align: left;
        }

            .file-list li {
                display: grid;
                grid-template-columns: 1fr 36px;
                align-items: center;
                gap: 10px;
                padding: 8px 12px;
                border: 1px dashed var(--border);
                border-radius: 10px;
                background: #fff;
            }

        .remove {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #f7f9ff;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .file-link {
            color: var(--blue2);
            font-weight: 600;
            text-decoration: none;
        }

            .file-link:hover {
                text-decoration: underline;
            }

        .toast-center {
            position: fixed;
            inset: 0;
            display: grid;
            place-items: center;
            z-index: 9999;
            pointer-events: none;
        }

        .toast-card {
            pointer-events: auto;
            min-width: 320px;
            max-width: 88vw;
            background: linear-gradient(180deg,var(--blue1),var(--blue2));
            color: #fff;
            border: 1px solid rgba(255,255,255,.28);
            border-radius: 18px;
            padding: 18px 22px;
            display: grid;
            grid-template-columns: 56px 1fr;
            gap: 14px;
            box-shadow: 0 18px 60px rgba(37,99,235,.35);
        }

        .toast-icon-v {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #10b981;
            color: #fff;
            font-weight: 900;
            font-size: 28px;
            box-shadow: 0 8px 22px rgba(16,185,129,.45);
        }

        .toast-text {
            font-weight: 700;
        }

        @@media (max-width:1200px) {
            .form-grid {
                grid-template-columns: repeat(2,minmax(220px,1fr));
            }
        }

        @@media (max-width:920px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        .form-control {
            width: 100%;
        }

        /* cao gấp 3 lần mặc định của textarea */
        .taller-3 {
            min-height: calc(var(--textarea-min-h) * 3);
        }

       

        .panel-default {
            border-color: #ddd;
            width: 90%;
            margin: auto;
        }
   
    </style>
}

<div class="page">
