                        </button>

                        <button type="button" class="btn  btn-outline ClassDisabled"  id="btnSubmitDisabled">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="var(--ico-indigo)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M22 2L11 13"></path>
                                <path d="M22 2l-7 20-4-9-9-4 20-7z"></path>
                            </svg>
                            Submit
                        </button>
                    }
                }
            </div>
        </div>

        <div class="content-grid">
            <section aria-label="Main form">
                <div class="card">
                    <h2 class="card-title">Request Information</h2>
