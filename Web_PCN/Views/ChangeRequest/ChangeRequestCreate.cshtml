                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div style="margin-bottom:8px; color:#64748b">No existing files yet.</div>
                    }
                    *@ -->

                    <div class="dropzone @(isLocked ? "disabled" : "")" id="dz" tabindex="0">
                        <div>Drag & drop files here or choose files to upload.</div>
                        <div style="margin-top:10px">
