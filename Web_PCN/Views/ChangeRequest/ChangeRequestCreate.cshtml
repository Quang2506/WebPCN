                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                <path d="M10 11v6M14 11v6"></path>
                                <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
                            </svg>
                            Delete
                        </button>

                        <button type="submit" name="actionType" value="Submit" class="btn btn-outline" id="btnSubmitExist">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="var(--ico-indigo)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M22 2L11 13"></path>
                                <path d="M22 2l-7 20-4-9-9-4 20-7z"></path>
                            </svg>
                            Submit
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn  btn-outline ClassDisabled"  id="btnEditDisabled">
