@model Core.Dtos.ChangeRequests

@{
    ViewBag.Title = "ChangeRequestDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/Content/changerequest.detail.css" />
    <style>
        :root {
            --card-pad: 12px;
            --gap-x: 12px;
            --gap-y: 10px;
            --field-gap: 6px;
            --control-h: 40px;
            --radius: 10px;
            --static-border: #d8deea;
        }

        .edit-bar {
            position: sticky;
            top: 0;
            z-index: 5;
            display: flex;
            justify-content: flex-end;
            padding: 8px 0 0;
        }

        .action-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn {
            --btn-bg: #f1f4fa;
            --btn-color: var(--dark,#1f2a37);
            position: relative;
            overflow: hidden;
            border: 1px solid transparent;
            border-radius: 10px;
            padding: 9px 14px;
            font-weight: 700;
            letter-spacing: .2px;
            background: var(--btn-bg);
            color: var(--btn-color);
            cursor: pointer;
            user-select: none;
            transition: transform .12s cubic-bezier(.2,.7,.2,1), box-shadow .18s, filter .18s;
        }

            .btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(31,42,55,.10);
            }

            .btn:active {
                transform: translateY(0);
                box-shadow: 0 4px 12px rgba(31,42,55,.08);
            }

            .btn::after {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: inherit;
                transform: scale(0);
                opacity: 0;
                pointer-events: none;
                background: radial-gradient(closest-side, rgba(255,255,255,.45), rgba(255,255,255,0));
                transition: transform .35s ease, opacity .55s ease;
            }

            .btn.is-pressed::after {
                transform: scale(3);
                opacity: 1;
            }

        .btn-outline {
            --btn-bg: #fff;
            border-color: #d3dbe7;
        }

        .btn-primary {
            --btn-bg: linear-gradient(180deg,#3b82f6 0%,#2563eb 100%);
            --btn-color: #fff;
        }

        .btn-success {
            --btn-bg: linear-gradient(180deg,#22c55e 0%,#16a34a 100%);
            --btn-color: #fff;
        }

        .btn-danger {
            --btn-bg: linear-gradient(180deg,#f87171 0%,#ef4444 100%);
            --btn-color: #fff;
        }

        .btn-warning {
            --btn-bg: linear-gradient(180deg,#f59e0b 0%,#d97706 100%);
            --btn-color: #111827;
        }

        .btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

        .page {
            max-width: 1220px;
            margin: 10px auto 0;
            padding: 0 16px;
        }

        .page--scroll {
            height: calc(100vh - 16px);
            overflow-y: auto;
            overflow-x: hidden;
            padding-bottom: 96px;
        }

        .breadcrumb, .page-header {
            display: none !important;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
            margin-top: 14px;
        }

        .card {
            background: #fff;
            border: 1px solid var(--border,#d9dee8);
            border-radius: 14px;
            padding: var(--card-pad);
            box-shadow: 0 4px 14px rgba(31,42,55,.06);
        }

            .card + .card {
                margin-top: 10px;
            }

        .card-title {
            font-weight: 700;
            font-size: 16px;
            margin: 2px 0 10px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(220px,1fr));
            column-gap: var(--gap-x);
            row-gap: var(--gap-y);
            align-items: start;
        }

            .form-grid .full {
                grid-column: 1 / -1;
            }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: var(--field-gap);
            margin: 0;
        }

            .form-group label {
                font-size: 11.5px;
                color: #6b7788;
                font-weight: 600;
                letter-spacing: .1px;
            }

            .form-group input[type="text"],
            .form-group input[type="date"],
            .form-group input[type="number"],
            .form-group select,
            .form-control {
                height: var(--control-h);
                padding: 0 10px !important;
                line-height: var(--control-h);
                border: 1px solid var(--border,#d9dee8);
                border-radius: var(--radius);
                background: #f7f9fc;
                color: #1f2a37;
                transition: background .18s, border-color .18s, box-shadow .18s;
            }

            .form-group textarea {
                min-height: calc(var(--control-h) * 3 + 6px);
                padding: 8px 10px !important;
                line-height: 1.45;
                resize: vertical;
                border: 1px solid var(--border,#d9dee8);
                border-radius: var(--radius);
                background: #f7f9fc;
                color: #1f2a37;
            }

                .form-group input::placeholder, .form-group textarea::placeholder {
                    color: #a7b1bf;
                }

                .form-group input:hover, .form-group select:hover, .form-group textarea:hover {
                    background: #fff;
                    border-color: #cbd3e2;
                }

                .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
                    outline: none;
                    background: #fff;
                    border-color: #2563eb;
                    box-shadow: 0 0 0 3px rgba(59,130,246,.12);
                }

        .form-control-static {
            min-height: var(--control-h);
            display: flex;
            align-items: center;
            padding: 0 10px;
            border: 1px dashed var(--static-border);
            border-radius: var(--radius);
            background: #fafcff;
            color: #4a5568;
        }

        .dropzone {
            border: 2px dashed #cad3e1;
            border-radius: 12px;
            padding: 16px;
            background: linear-gradient(180deg,#fbfdff 0%,#f6f9ff 100%);
            text-align: center;
            color: #7c8799;
            transition: border-color .2s, box-shadow .2s, transform .2s;
        }

            .dropzone:hover {
                border-color: #2563eb;
                box-shadow: 0 4px 14px rgba(31,42,55,.06);
                transform: translateY(-1px);
            }

            .dropzone.dragover {
                border-color: #22c55e;
                box-shadow: 0 0 0 4px rgba(34,197,94,.14);
            }

        @@media (max-width:1200px) {
            .form-grid {
                grid-template-columns: repeat(2, minmax(220px,1fr));
            }
        }

        @@media (max-width:920px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        .alert-inline {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #374151;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            padding: 8px 10px;
            border-radius: 10px;
            margin-left: 8px;
        }

        /* ==================== LUCAS CHANGE DETAIL: STYLE FILE LIST ==================== */
        .file-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .file-item {
            padding: 10px 12px;
            background: #fff;
            border: 1px dashed #d1d5db;
            border-radius: 10px;
        }

        .file-link {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-decoration: none;
            color: #1f2a37;
            font-weight: 700;
        }

            .file-link:hover {
                text-decoration: underline;
            }

        .btn.btn-outline {
            background: #fff;
        }
        /* ============================================================================ */
    </style>
}

<body>
    <div class="page">

        <!-- Breadcrumb & Header -->
        <div class="breadcrumb">
            <a href="@Url.Action("Index","Home")">Home</a> / <a href="#">Change Request</a> / <span>New</span>
        </div>

        @* --- Alert sau khi Redirect --- *@
        @if (TempData["Success"] != null)
        {<div class="alert alert-success">@TempData["Success"]</div>}
        @if (TempData["Error"] != null)
        {<div class="alert alert-danger">@TempData["Error"]</div> }

    @* --- Form xử lý Approve / Reject --- *@
        @using (Html.BeginForm("ProcessAction", "ChangeRequest", FormMethod.Post, new { id = "processForm" }))
        {
            @Html.AntiForgeryToken()

            @Html.Hidden("requestId", Model.requestid)
            @Html.Hidden("dep_c", Model.dep_c)
            @Html.Hidden("user", User.Identity.Name)

            <div class="footer-actions" style="margin: 12px 0;">
                <button type="submit" name="actionCode" value="APPROVE" class="btn btn-success">Approve</button>
                <button type="submit" name="actionCode" value="REJECT" class="btn btn-danger"
                        onclick="return confirm('Are you sure to Reject this request?');">
                    Reject
                </button>
            </div>
        }

        <button class="btn btn-primary" type="button" onclick="redirectToStatus('@Model.requestid', '@Model.dep_c')">
            Show flow
        </button>

        <div class="content-grid">
            <!-- Left: Main form -->
            <div>
                <!-- General info -->
                <div class="card">
                    <div class="card-title">Thông tin yêu cầu</div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="Code">Category:</label>
                            <input type="text" id="Category" name="Code" placeholder="VD: CR-2025-001" />
                        </div>
                        <div class="form-group">
                            <label for="Code">Document Code:</label>
                            @Html.TextBoxFor(m => m.DocumentCode, new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            <label for="Title">Version</label>
                            @Html.TextBoxFor(m => m.version, new { @class = "form-control" })
                        </div>

                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label for="Title">Change Title</label>
                            @Html.TextBoxFor(m => m.ChangeTitle, new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            <label for="Category">Model</label>
                            @Html.TextBoxFor(m => m.Model, new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            <label for="Department">Department group</label>
                            <p class="form-control-static">@Model.group_dept</p>
                        </div>

                        <div class="form-group">
                            <label for="Requester">Người yêu cầu</label>
                            <p class="form-control-static">@Model.pms_i_usr</p>
                        </div>

                        <div class="form-group">
                            <label for="RequestDate">Ngày tạo</label>
                            <p class="form-control-static">@Model.pms_i_ymd</p>
                        </div>
                        <div class="form-group">
                            <label for="Status">Trạng thái</label>
                            <p class="form-control-static">@Model.Status</p>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label for="Description">Mô tả</label>
                            @Html.TextAreaFor(m => m.Request_detail)
                        </div>
                    </div>
                </div>

                <!-- ====================== LUCAS CHANGE DETAIL: ĐÍNH KÈM (CLICK TÊN -> TẢI) ====================== -->
                <div class="card">
                    <div class="card-title">Đính kèm</div>

                    @{
                        // Danh sách file đã được controller đổ vào ViewBag.Files (list ChangeRequestFileDto hoặc dynamic có FileName/ChangeRequestID)
                        var files = ViewBag.Files as IEnumerable<dynamic>;

                        // Mã hoá token URL-safe theo TÊN FILE (KHÔNG dùng full path)
                        /* LUCAS CHANGE DETAIL */
                        Func<string, string> Enc = s => System.Web.HttpServerUtility
                            .UrlTokenEncode(System.Text.Encoding.UTF8.GetBytes(s ?? ""));
                    }

                    @if (files == null || !files.Any())
                    {
                        <div>Không có tệp đính kèm cho yêu cầu này.</div>
                    }
                    else
                    {
                        <ul class="file-list">
                            @foreach (var f in files)
                            {
                                string rid = (string)f.ChangeRequestID;
                                string name = (string)f.FileName;@* LUCAS CHANGE DETAIL: dùng TÊN FILE *@
                                string p = Enc(name); @* LUCAS CHANGE DETAIL: token = tên file *@

                                <li class="file-item">
                                    <a class="file-link" title="Tải @name"
                                       href="@Url.Action("Download","ChangeRequest", new { requestId = rid, p = p })">
                                        @name
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <!-- ============================================================================================ -->
                <!-- Comments -->
                <div class="card">
                    <div class="card-title">Ghi chú/Bình luận</div>
                    <div class="form-group">
                        <textarea id="Comments" name="Comments" placeholder="Nhập bình luận nội bộ hoặc ghi chú bổ sung..."></textarea>
                    </div>
                </div>
            </div>

            @* Right summary (giữ nguyên nếu cần) *@
        </div>

        <script>
             function redirectToStatus(changeRequestID, dep_c) {
                 window.location.href = '@Url.Action("Status", "WorkFlow")' + '?changeRequestID=' + changeRequestID + '&dep_c=' + dep_c;
             }
        </script>
    </div>
</body>
