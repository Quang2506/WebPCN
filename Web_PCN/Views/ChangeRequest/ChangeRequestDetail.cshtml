

@model Core.Dtos.ChangeRequests

@{
    ViewBag.Title = "ChangeRequestDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        :root {
            /* Có thể đổi nhanh bảng màu ở đây */
            --bg: #e8ebf1; /* nền tổng thể (gần giống ảnh) */
            --surface: #ffffff; /* nền card */
            --primary: #4a8ccf; /* màu chủ đạo (nút/header) */
            --border: #cacccf; /* viền nhạt */
            --muted: #828d9c; /* chữ phụ/placeholder */
            --dark: #243243; /* chữ chính */
            --hl: #f2f5fb; /* nền header bảng */
            --danger: #e55353; /* cảnh báo */
            --success: #22a06b; /* thành công */
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--dark);
            font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.45;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .page {
            max-width: 1280px;
            margin: 24px auto;
            padding: 0 16px;
        }

        /* Breadcrumb + tiêu đề */
        .breadcrumb {
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 8px;
        }

            .breadcrumb a {
                color: var(--muted);
            }

        .page-header {
            background: var(--primary);
            color: #fff;
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 10px rgba(36,50,67,0.12);
        }

        .page-title {
            font-size: 20px;
            font-weight: 600;
        }

        .header-actions {
            display: flex;
            gap: 8px;
        }

        /* Toolbar (search + filter) */
        .toolbar {
            margin-top: 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
            display: grid;
            grid-template-columns: 1fr repeat(3, max-content);
            gap: 10px;
            align-items: center;
        }

            .search-input input,
            .toolbar select {
                width: 100%;
                padding: 10px 12px;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: #f7f8fb;
                color: var(--dark);
            }

        /* Card/Form */
        /*.content-grid {
            display: grid;
            grid-template-columns: 1fr 340px;*/ /* form trái, tóm tắt phải */
        /*gap: 16px;
            margin-top: 16px;
        }*/


        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) clamp(260px, 24vw, 320px);
            /*grid-template-columns: minmax(0, 1fr) clamp(280px, 30vw, 360px);*/
            gap: 16px;
            margin-top: 16px;
        }

            .content-grid > * {
                min-width: 0;
            }



        .form-grid > * {
            min-width: 0;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 2px 8px rgba(36,50,67,0.06);
        }

            .card + .card {
                margin-top: 16px;
            }

        .card-title {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 12px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(240px, 1fr));
            gap: 14px 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .form-group label {
                font-size: 12.5px;
                color: var(--muted);
            }

            .form-group input[type="text"],
            .form-group input[type="date"],
            .form-group input[type="number"],
            .form-group select,
            .form-group textarea {
                padding: 10px 12px;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: #f7f8fb;
                color: var(--dark);
                outline: none;
            }

            .form-group textarea {
                min-height: 96px;
                resize: vertical;
            }

        /* Attachments */
        .dropzone {
            border: 2px dashed var(--border);
            border-radius: 10px;
            padding: 16px;
            background: #fbfcfe;
            text-align: center;
            color: var(--muted);
        }

        /* Table (Items) */
        .table-wrap {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background: var(--hl);
        }

        th, td {
            font-size: 14px;
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        th {
            text-align: left;
            font-weight: 600;
        }

        tr:hover td {
            background: #fafbfe;
        }

        .td-actions {
            white-space: nowrap;
        }

        /* Summary (panel phải) */
        .summary {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

            .summary .row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 8px 10px;
                border: 1px dashed var(--border);
                border-radius: 10px;
                background: #f7f9fd;
            }

            .summary .label {
                color: var(--muted);
                font-size: 13px;
            }

            .summary .value {
                font-weight: 700;
            }

        /* Footer actions */
        .footer-actions {
            margin-top: 16px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        /* Buttons */
        .btn {
            border: none;
            border-radius: 8px;
            padding: 10px 14px;
            cursor: pointer;
            font-weight: 600;
            letter-spacing: 0.2px;
            background: #e9ecf3;
            color: var(--dark);
        }

        .btn-outline {
            background: #fff;
            border: 1px solid var(--border);
        }

        .btn-primary {
            background: var(--primary);
            color: #fff;
        }

        .btn-danger {
            background: var(--danger);
            color: #fff;
        }

        .btn-success {
            background: var(--success);
            color: #fff;
        }

        .btn-link {
            background: transparent;
            color: var(--primary);
        }

        /* Responsive */

        @@media (max-width: 1366px) {
            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        /*  @@media (max-width: 1080px) {
            .content-grid { grid-template-columns: 1fr; }
        }*/
        @@media (max-width: 920px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .toolbar {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>



