                            </div>

                            <div class="form-group" style="grid-column: 1 / -1;">
                                <label for="Title">Change Title</label>
                                @Html.TextBoxFor(m => m.ChangeTitle, new { @class = "form-control" })
                                @* <input type="text" id="Title" name="Title" placeholder="Nhập tiêu đề..." />*@
                            </div>

                            <div class="form-group">
                                <label for="Category">Model</label>
                                @Html.TextBoxFor(m => m.Model, new { @class = "form-control" })



                                @*<select id="Category" name="Category">
                                        <option value="">— Select —</option>
                                        <option value="bug">Sửa lỗi</option>
                                        <option value="feature">Tính năng mới</option>
                                        <option value="improve">Cải tiến</option>
                                    </select>*@
                            </div>

                            <div class="form-group">
                                <label for="Department">Department group</label>
                                <p class="form-control-static">@Model.group_dept</p>

                            </div>

                            <div class="form-group">
                                <label for="Requester">Người yêu cầu</label>
                                <p class="form-control-static">@Model.pms_i_usr</p>
                            </div>


                            <div class="form-group">
                                <label for="RequestDate">Ngày tạo</label>
