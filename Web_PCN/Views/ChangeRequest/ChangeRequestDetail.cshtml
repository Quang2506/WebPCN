                            </div>
                            <div class="form-group" style="grid-column: 1 / -1;">
                                <label for="Description">Mô tả</label>
                                @Html.TextAreaFor(m => m.Request_detail)
                            </div>

                        </div>
                    </div>

                    <!-- Attachments -->
                    <div class="card">
                        <div class="card-title">Đính kèm</div>
