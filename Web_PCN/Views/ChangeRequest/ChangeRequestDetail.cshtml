@model Core.Dtos.ChangeRequests
@{
    ViewBag.Title = "ChangeRequestDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/changerequest.detail.css" />
}

<div class="page page--scroll">

    @* XÓA header/breadcrumb: không render *@
    @* <nav class="breadcrumb">...</nav>
        <header class="page-header">...</header> *@

    <form id="crForm" method="post" action="@Url.Action("Create","ChangeRequest")" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <div class="content-grid">
            <!-- LEFT: Main form -->
            <section aria-label="Chi tiết yêu cầu">
                <div class="card">
                    <div class="card-title">Thông tin yêu cầu</div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label for="Category">Category</label>
                            <input id="Category" name="Code" type="text" placeholder="VD: Change Management" />
                        </div>

                        <div class="form-group">
                            <label for="DocumentCode">Document Code</label>
                            @Html.TextBoxFor(m => m.DocumentCode, new { @id = "DocumentCode", @class = "form-control", placeholder = "VD: CR-2025-001" })
                        </div>

                        <div class="form-group">
                            <label for="version">Version</label>
                            @Html.TextBoxFor(m => m.version, new { @id = "version", @class = "form-control", placeholder = "VD: v1.0" })
                        </div>

                        <div class="form-group full">
                            <label for="ChangeTitle">Change Title</label>
                            @Html.TextBoxFor(m => m.ChangeTitle, new { @id = "ChangeTitle", @class = "form-control", placeholder = "Nhập tiêu đề..." })
                        </div>

                        <div class="form-group">
                            <label for="Model">Model</label>
                            @Html.DropDownListFor(m => m.Model, (SelectList)ViewBag.ModelList, "-- Select --", new { @id = "Model", @class = "form-control" })
                        </div>

                        <div class="form-group">
                            <label>Department group</label>
                            <p class="form-control-static">@Model.group_dept</p>
                        </div>

                        <div class="form-group">
                            <label>Người yêu cầu</label>
                            <p class="form-control-static">@Model.pms_i_usr</p>
                        </div>

                        <div class="form-group">
                            <label>Ngày tạo</label>
                            <p class="form-control-static">@Model.pms_i_ymd</p>
                        </div>

                        <div class="form-group">
                            <label>Trạng thái</label>
                            <p class="form-control-static">@Model.Status</p>
                        </div>

                        <div class="form-group full">
                            <label for="Request_detail">Mô tả</label>
                            @Html.TextAreaFor(m => m.Request_detail, new { @id = "Request_detail", @rows = "5", @class = "form-control", placeholder = "Mô tả chi tiết..." })
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">Đính kèm</div>
                    <div class="dropzone" id="dz">
                        Kéo & thả tệp vào đây hoặc chọn tệp để tải lên.
                        <div style="margin-top:10px">
                            <input type="file" id="Files" name="Files" multiple />
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">Ghi chú/Bình luận</div>
                    <div class="form-group">
                        <textarea id="Comments" name="Comments" placeholder="Nhập bình luận nội bộ hoặc ghi chú bổ sung..." rows="4"></textarea>
                    </div>
                </div>

                <!-- Sticky Footer Actions -->
                <div class="footer-actions footer-actions--sticky">
                    <button class="btn btn-outline" type="button" onclick="history.back()">Hủy</button>
                    <button class="btn btn-primary" type="submit">Lưu</button>
                    <button class="btn btn-success" type="button" onclick="submitForApproval()">Gửi duyệt</button>
                </div>
            </section>

            @* RIGHT summary đã bỏ; nếu sau cần lại có thể thêm <aside> *@
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function submitForApproval() {
            document.getElementById('crForm').requestSubmit();
        }
        // dragover effect
        (function () {
            const dz = document.getElementById('dz');
            if (!dz) return;
            ['dragenter', 'dragover'].forEach(e => dz.addEventListener(e, ev => { ev.preventDefault(); dz.classList.add('dragover'); }));
            ['dragleave', 'drop'].forEach(e => dz.addEventListener(e, ev => { ev.preventDefault(); dz.classList.remove('dragover'); }));
        })();
    </script>
}
