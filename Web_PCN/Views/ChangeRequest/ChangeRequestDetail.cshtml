@model Core.Dtos.ChangeRequests

@{
    ViewBag.Title = "ChangeRequestDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Quyền từ controller
    string actionRight = ViewBag.ActionRight as string ?? "";
    bool canApproveReject = ViewBag.CanApproveReject == true;
    bool canSync = ViewBag.CanSync == true;
}

@section Styles {
    <link rel="stylesheet" href="~/Content/changerequest.detail.css" />
    <style>
        :root {
            --card-pad: 12px;
            --gap-x: 12px;
            --gap-y: 10px;
            --field-gap: 6px;
            --control-h: 40px;
            --radius: 10px;
            --static-border: #d8deea;
            --border: #d9dee8;
            --primary: #3b82f6;
            --primary-600: #2563eb;
            --primary-700: #1d4ed8;
            --green: #22c55e;
            --red: #ef4444;
            --violet: #8b5cf6;
        }

        /* OUTER scrollbar */
        html, body {
            min-height: 100% !important;
            height: auto !important;
            overflow-x: hidden !important;
            background: #f3f4f6;
            scrollbar-gutter: stable
        }

        html {
            overflow-y: auto !important
        }

        body {
            overflow-y: auto !important;
            scrollbar-width: thin;
            scrollbar-color: #c7d2fe #eef2ff
        }

            body::-webkit-scrollbar {
                width: 10px
            }

            body::-webkit-scrollbar-thumb {
                background: #c7d2fe;
                border-radius: 8px
            }

            body::-webkit-scrollbar-track {
                background: #eef2ff
            }

        .page {
            max-width: 1220px;
            margin: 10px auto 24px;
            padding: 0 16px;
            min-height: 100vh
        }

        .breadcrumb {
            color: #64748b;
            font-size: 13px;
            margin: 4px 0 8px
        }

            .breadcrumb a {
                color: #3b82f6;
                text-decoration: none
            }

                .breadcrumb a:hover {
                    text-decoration: underline
                }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
            margin-top: 14px
        }

        .card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: var(--card-pad);
            box-shadow: 0 4px 14px rgba(31,42,55,.06)
        }

            .card + .card {
                margin-top: 10px
            }

        .card-title {
            font-weight: 700;
            font-size: 16px;
            margin: 2px 0 10px
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(220px,1fr));
            column-gap: var(--gap-x);
            row-gap: var(--gap-y);
            align-items: start
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: var(--field-gap);
            margin: 0
        }

            .form-group label {
                font-size: 11.5px;
                color: #6b7788;
                font-weight: 600;
                letter-spacing: .1px
            }

            .form-control,
            .form-group input[type="text"], .form-group input[type="date"],
            .form-group input[type="number"], .form-group select {
                height: var(--control-h);
                padding: 0 10px !important;
                line-height: var(--control-h);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                background: #f7f9fc;
                color: #1f2a37
            }

            .form-group textarea {
                min-height: calc(var(--control-h)*3 + 6px);
                padding: 8px 10px !important;
                line-height: 1.45;
                resize: vertical;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                background: #f7f9fc;
                color: #1f2a37
            }

        .form-control-static {
            min-height: var(--control-h);
            display: flex;
            align-items: center;
            padding: 0 10px;
            border: 1px dashed var(--static-border);
            border-radius: var(--radius);
            background: #fafcff;
            color: #4a5568
        }

        .file-list {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 10px
        }

        .file-item {
            padding: 10px 12px;
            background: #fff;
            border: 1px dashed #d1d5db;
            border-radius: 10px
        }

        .file-link {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-decoration: none;
            color: #1f2a37;
            font-weight: 700
        }

            .file-link:hover {
                text-decoration: underline
            }

        /* Actions */
        .actions-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin: 12px 0
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            height: 42px;
            padding: 0 16px;
            border-radius: 12px;
            border: 1px solid var(--primary);
            background: var(--primary);
            color: #fff;
            font-weight: 700;
            line-height: 1;
            text-decoration: none;
            box-shadow: 0 6px 16px rgba(37,99,235,.18);
            transition: transform .12s ease,background .12s ease,box-shadow .12s ease
        }

            .action-btn:hover {
                background: var(--primary-600);
                box-shadow: 0 8px 20px rgba(29,78,216,.22)
            }

            .action-btn:active {
                transform: translateY(1px);
                background: var(--primary-700)
            }

            .action-btn svg {
                width: 20px;
                height: 20px;
                stroke-width: 2.2;
                fill: none;
                stroke: currentColor
            }

        .icon--approve {
            color: var(--green)
        }

        .icon--reject {
            color: var(--red)
        }

        .icon--flow {
            color: var(--violet)
        }

        .icon--sync {
            color: #ffffff
        }
        /* Giữ trắng như yêu cầu */

        @@media (max-width:1200px) {
            .form-grid {
                grid-template-columns: repeat(2,minmax(220px,1fr))
            }
        }

        @@media (max-width:920px) {
            .form-grid {
                grid-template-columns: 1fr
            }
        }
    </style>
}

<div class="page">
    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a href="@Url.Action("Index","Home")">Home</a> /
        <a href="@Url.Action("Index","ChangeRequest")">Change Request</a> /
        <span>Detail</span>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {<div class="alert alert-success">@TempData["Success"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}

    <!-- Actions (ẩn/hiện theo quyền) -->
    @using (Html.BeginForm("ProcessAction", "ChangeRequest", FormMethod.Post, new { id = "processForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("requestId", Model.requestid)
        @Html.Hidden("dep_c", Model.dep_c)
        @Html.Hidden("user", User.Identity.Name)

        <div class="actions-bar">
            @if (canApproveReject)
            {
                <!-- APPROVE -->
                <button type="submit" name="actionCode" value="APPROVE" class="action-btn" title="Approve">
                    <svg class="icon--approve" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M8 12l2.4 2.4L16 8.8"></path>
                    </svg>
                    <span>Approve</span>
                </button>

                <!-- REJECT -->
                <button type="submit" name="actionCode" value="REJECT" class="action-btn" title="Reject"
                        onclick="return confirm('Are you sure you want to reject this request?');">
                    <svg class="icon--reject" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M9 9l6 6M15 9l-6 6"></path>
                    </svg>
                    <span>Reject</span>
                </button>
            }
            else if (canSync)
            {
                <!-- SYNC (icon hình bút) -->
                <button type="submit" name="actionCode" value="SYNC" class="action-btn" title="Sync">
                    <svg class="icon--sync" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 20h9"></path>
                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                    <span>Sync</span>
                </button>
            }

            <!-- FLOW: luôn hiển thị -->
            <button type="button" class="action-btn" title="Show flow"
                    onclick="redirectToStatus('@Model.requestid', '@Model.dep_c','@Model.dep_nm','@Model.site','@Model.factory')">
                <svg class="icon--flow" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="5" cy="6" r="2"></circle>
                    <circle cx="12" cy="12" r="2"></circle>
                    <circle cx="19" cy="18" r="2"></circle>
                    <path d="M6.8 7.2L10 10.4"></path>
                    <path d="M13.6 13.6L17 16.9"></path>
                    <path d="M9.6 10l1 0v1"></path>
                    <path d="M16.2 16.1l1 0v1"></path>
                </svg>
                <span>Flow</span>
            </button>
        </div>
    }

    <div class="content-grid">
        <div>
            <div class="card">
                <div class="card-title">Request Information</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="Category">Category</label>
                        <input id="Category" type="text" class="form-control" value="@Model.category_nm" readonly />
                    </div>

                    <div class="form-group">
                        <label for="DocumentCode">Document Code</label>
                        @Html.TextBoxFor(m => m.DocumentCode, new { @class = "form-control", @readonly = "readonly" })
                    </div>

                    <div class="form-group">
                        <label for="Version">Version</label>
                        @Html.TextBoxFor(m => m.version, new { @class = "form-control", @readonly = "readonly" })
                    </div>

                    <div class="form-group" style="grid-column:1 / -1;">
                        <label for="ChangeTitle">Change Title</label>
                        @Html.TextBoxFor(m => m.ChangeTitle, new { @class = "form-control", @readonly = "readonly" })
                    </div>

                    <div class="form-group">
                        <label for="Model">Model</label>
                        @Html.TextBoxFor(m => m.Model, new { @class = "form-control", @readonly = "readonly" })
                    </div>

                    <div class="form-group">
                        <label>Department </label>
                        <p class="form-control-static">@Model.dep_nm</p>
                    </div>
                    <div class="form-group">
                        <label>Factory</label>
                        <p class="form-control-static">@Model.factory</p>
                    </div>
                    <div class="form-group">
                        <label>Site</label>
                        <p class="form-control-static">@Model.site</p>
                    </div>

                    <div class="form-group">
                        <label>Requester</label>
                        <p class="form-control-static">@Model.pms_i_usr</p>
                    </div>

                    <div class="form-group">
                        <label>Created At</label>
                        <p class="form-control-static">@Model.pms_i_ymd</p>
                    </div>

                    <div class="form-group">
                        <label>Status</label>
                        <p class="form-control-static">@Model.status_nm</p>
                    </div>

                    <div class="form-group" style="grid-column:1 / -1;">
                        <label for="Request_detail">Description</label>
                        @Html.TextAreaFor(m => m.Request_detail, new { @readonly = "readonly" })
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-title">Attachments</div>
                @{
                    var files = ViewBag.Files as IEnumerable<KeyValuePair<string, string>>;
                }
                @if (files == null || !files.Any())
                {
                    <div>No attachments for this request.</div>
                }
                else
                {
                    <ul class="file-list">
                        @foreach (var kv in files)
                        {
                            var name = kv.Key;
                            var p = kv.Value;
                            <li class="file-item">
                                <a class="file-link" title="Download @name"
                                   href="@Url.Action("Download","ChangeRequest", new { requestId = Model.requestid, p = p })">
                                    @name
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="card">
                <div class="card-title">Notes / Comments</div>
                <div class="form-group">
                    <textarea id="Comments" name="Comments" placeholder="Enter an internal note or any additional remarks..."></textarea>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        function redirectToStatus(changeRequestID, dep_c, dep_nm, site, factory){
            window.location.href = '@Url.Action("Status", "WorkFlow")'
                + '?changeRequestID=' + encodeURIComponent(changeRequestID)
                + '&dep_c=' + encodeURIComponent(dep_c)
                + '&dep_nm=' + encodeURIComponent(dep_nm)
                + '&site=' + encodeURIComponent(site)
                + '&factory=' + encodeURIComponent(factory);
        }
    </script>
}
