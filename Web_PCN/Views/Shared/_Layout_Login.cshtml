@*
    Layout riêng cho trang Đăng nhập (offline)
    - Bootstrap 5 (file local)
    - Nhúng SVG sprite icon (offline)
*@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 5 CSS (LOCAL): đảm bảo có ~/Content/bootstrap.min.css -->
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />

    @RenderSection("Styles", required: false)
</head>
<body class="bg-light">
    <!-- Sprite icon nội bộ (offline) -->
    @Html.Partial("~/Views/Shared/_IconsSprite.cshtml")

    @RenderBody()

    <!-- Bootstrap 5 JS bundle (LOCAL) -->
    <script src="~/Scripts/bootstrap3/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
