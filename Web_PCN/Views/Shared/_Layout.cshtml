
@{
    Layout = null;
    var title = ViewBag.Title as string ?? "PCN Home";


    var userName = "UserA";
    // var userName = Session["UserName"] as string; // đã lưu ở bước login  dùng để lấy section
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 3 CSS -->
    <link href="~/Content/bootstrap3/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Site CSS -->
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body class="sfc-body">
    <div class="container-fluid sfc-shell">
        <div class="row">
            <!-- SIDEBAR -->
            <aside class="col-sm-3 col-md-2 sfc-sidebar">
                <div class="sfc-brand">P C N</div>
                @Html.Action("LeftMenu", "Home")
            </aside>

            <!-- MAIN -->
            <main class="col-sm-9 col-md-10 sfc-main">
                <!-- Topbar -->
                <div class="sfc-topbar clearfix">
                    <span class="sfc-topbar-title">@title</span>
                    <div class="pull-right">
                        <span class="text-muted">Xin chào, @userName</span>
                    </div>
                </div>

                <!-- Content -->
                <div class="sfc-content">
                    @RenderBody()



                </div>
            </main>
        </div>
    </div>


    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/bootstrap3/bootstrap.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
<script>
    (function () {
        // Đảm bảo chỉ mở 1 nhóm con trong .sfc-menu
        $(document).on('click', '.sfc-parent__link', function () {
            var $link = $(this);
            var target = $($link.data('target'));
            var $siblings = $link.closest('ul.sfc-menu, ul.sfc-submenu').find('> li > ul.collapse').not(target);
            $siblings.collapse('hide'); // đóng các nhóm khác
        });

        // Cập nhật aria-expanded để CSS caret xoay
        $('.sfc-menu').on('shown.bs.collapse hidden.bs.collapse', function (e) {
            var $ul = $(e.target);
            var $a = $('a[data-target="#' + $ul.attr('id') + '"]');
            $a.attr('aria-expanded', $ul.hasClass('in'));
        });
    })();
</script>
