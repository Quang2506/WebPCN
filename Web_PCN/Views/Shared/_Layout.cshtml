@using System.Web.Mvc
@{
    Layout = null;
    var title = ViewBag.Title as string ?? "PCN Home";

    // lấy từ Session (set khi login)
    //var userName = Session["UserName"] as string;
    var Permit = Session["UserName"] as string;

    // Cờ bật/tắt sidebar (mặc định false)
    bool useLeftMenu = (ViewBag.UseLeftMenu as bool?) == true;

    // Lưới hiển thị main
    string mainCols = useLeftMenu ? "col-sm-9 col-md-10" : "col-sm-12 col-md-12";

    // Body class
    string bodyClass = useLeftMenu ? "sfc-body sfc-body--main-scroll" : "sfc-body";
    var parent = (Session["MenuParentName"] as string) ?? "";
    var child = (Session["MenuChildName"] as string) ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/Content/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />

    <link href="~/Content/bootstrap3/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)

    <style>
         /* ============================
        Biến màu dùng chung
        ============================ */
         :root {
             --bar: #87c9d3; /* xanh ngọc nền */
             --bar-deep: #6fb9c6;
             --white: #ffffff;
             --link: #ffffff;
             --link-hover: #eaf9fc;
         }

         /* ============================
        Thiết lập layout chính
        ============================ */
         html, body {
             margin: 0;
             padding: 0;
             height: 100vh; /* Chiếm toàn bộ chiều cao màn hình */
             overflow: hidden !important; /* Ngăn cuộn ở body */
             box-sizing: border-box;
         }

         *, *:before, *:after {
             box-sizing: inherit;
         }

         .sfc-shell {
             height: 100vh;
         }

         /* === THAY ĐỔI QUAN TRỌNG: Bố cục Flex cho Main Content === */
         .sfc-main {
             display: flex;
             flex-direction: column; /* Sắp xếp các phần tử con theo chiều dọc */
             height: 100vh; /* Chiều cao tối đa */
             padding: 0; /* Bootstrap có thể thêm padding, ta reset nó */
             background-color: #FAFAFA !important
         }

         .sfc-content {
             flex-grow: 1; /* Cho phép nội dung chính co giãn để lấp đầy không gian */
             /*overflow-y: auto;*/ /* Thêm thanh cuộn khi nội dung dài hơn */
             min-height: 0; /* Cần thiết cho flexbox hoạt động đúng trong một số trình duyệt */
             background-color: none;
            /* padding: 0 120px !important;*/
             padding-top: 30px !important;
/*             background:red*/
             width:100%
         }


         /* ============================
        Header Styles
        ============================ */
         .header {
             background-color: #FFFFFF;
             color: white;
             padding: 0 18px;
             display: flex;
             justify-content: space-between;
             align-items: center;
             height: 69px;
             flex-shrink: 0;
             box-shadow: 0 12px 28px rgba(0, 0, 0, .06);
             width: 76%;
             margin: auto;
             border-radius: 5px;
             margin-top: 27px;
         }

         .logo-title {
             display: flex;
             align-items: center;
         }

         .logo {
             height: 70px; /* Điều chỉnh logo nhỏ hơn một chút */
             margin-right: 15px;
         }

         .legend span {
             /* font-weight: 700; */
             color: #334155;
         }

         .header h1 {
             font-size: 24px; /* Giảm kích thước font một chút */
             margin: 0;
             font-weight: bold;
         }

         .pcn-home-link {
             color: #1D2025;
             text-decoration: none;
         }

             .pcn-home-link:hover {
                 text-decoration: underline;
             }

         .nav-links {
             display: flex;
             align-items: center;
             gap: 15px;
         }

             .nav-links a {
                 color: #0D0D0D;
                 text-decoration: none;
                 font-weight: 500;
             }

             .nav-links .sep {
                 color: #E6E8E9;
                 user-select: none;
             }

             .nav-links .id a {
                /* font-style: italic;*/
                 font-size: 14px;
             }

         /* Hiệu ứng nhấp nháy cho link logout */
         .pcn-logout-link {
             transition: color 0.2s ease;
             animation: blink-logout 2.5s infinite;
         }

             .pcn-logout-link:hover {
                 color: var(--link-hover);
                 animation-play-state: paused; /* Dừng nhấp nháy khi di chuột vào */
             }

         @@keyframes blink-logout {
             0%, 100% {
                 opacity: 1;
             }

             50% {
                 opacity: 0.6;
             }
         }

         /* ============================
        Footer Styles
        ============================ */
         .footer-bar {
             height: 50px;
             background: #F9F9F9;
             display: flex;
             align-items: center;
             justify-content: center;
             font-weight: 600;
             color: #A0A6AA;
             flex-shrink: 0; /* Không cho footer co lại */
         }
    </style>
</head>

<body>
    <div class="container-fluid sfc-shell">
        <div class="row" style="width:100%">
            @*@if (useLeftMenu)
                {
                    <aside class="col-sm-3 col-md-2 sfc-sidebar">
                        @Html.Action("LeftMenu", "Home")
                    </aside>
                }*@

            <main class="sfc-main">
                <div class="header">
                    <div class="logo-title">
                        <img class="logo" src="~/Content/images/quanta_logo.png" alt="Logo" />
                        <h1>
                            <a href="@Url.Action("Index", "Home")" class="pcn-home-link" title="Home">
                                Process Change Notice
                            </a>
                        </h1>
                    </div>
                    @{
                        if ((Session["Permit"]?.ToString() ?? "") == "3")
                        {
                            
                                        <div class="nav-links">

                                            <span class="id"> <a href="#" >ID: @Session["UserName"]</a>
                                                </span><span class="sep">|</span>
                                            <a href="@Url.Action("Logout", "Account")" class="pcn-logout-link" title="Logout">
                                                <i class="fa fa-sign-out"></i>
                                            </a>
                                        </div>
                        }
                        else
                        {
                <div class="nav-links">
                    <a href="@Url.Action("MyApproval", "Page")">My Tasks</a><span class="sep">|</span>
                    <a href="@Url.Action("MyChangeRequest", "Page")">My change request</a><span class="sep">|</span>
                    <a href="@Url.Action("ChangeRequestCreate", "ChangeRequest")">Create change request</a><span class="sep">|</span>
                    <span class="id">
                        <a href="#">ID: @Session["UserName"]</a>
                    </span><span class="sep">|</span>
                    <a href="@Url.Action("Logout", "Account")" class="pcn-logout-link" title="Logout">
                        <i class="fa fa-sign-out"></i>
                    </a>
                </div>
                        }

                    }


                </div>

                <div class="sfc-content">
                    @RenderBody()
                </div>

                <div class="footer-bar">
                    Copyright © QMH QMS
                </div>
            </main>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/bootstrap3/bootstrap.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>