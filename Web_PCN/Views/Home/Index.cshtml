@model Core.Dtos.DashboardViewModel
@using System
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var lines = (Model?.Lines != null && Model.Lines.Any())
        ? Model.Lines
        : (Model?.Grid ?? Enumerable.Empty<Core.Dtos.DeptCell>())
            .Select(x => x.Line).Distinct().OrderBy(x => x).ToList();

    var cols = (Model?.Depts != null && Model.Depts.Any())
        ? Model.Depts
        : (Model?.Grid ?? Enumerable.Empty<Core.Dtos.DeptCell>())
            .Select(x => x.Dept).Distinct().OrderBy(x => x).ToList();

    Func<string, string, Core.Dtos.DeptCell> CellOf = (ln, dp) =>
        (Model?.Grid ?? Enumerable.Empty<Core.Dtos.DeptCell>())
        .FirstOrDefault(x =>
            string.Equals(x.Line, ln, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(x.Dept, dp, StringComparison.OrdinalIgnoreCase));

    var plant = string.IsNullOrWhiteSpace(Model?.Plant) ? "QSMC" : Model.Plant.ToUpperInvariant();

    var syncQSMC = Math.Max(0, Math.Min(100, Model?.SyncRate_QSMC ?? 0));
    var syncQMH = Math.Max(0, Math.Min(100, Model?.SyncRate_QMH ?? 0));
    var nsQSMC = Model?.NotSynced_QSMC ?? 0;
    var nsQMH = Model?.NotSynced_QMH ?? 0;
    var Total = Model?.Total ?? 0;
    var nsTotal = nsQSMC + nsQMH;
}

<style>
    :root {
        /* ===== PALETTE khớp hình ===== */
        --page: #f6f8fb;
        /* Card xanh nhạt (Sync) */
        --card-green-bg: #eaf7ed;
        --card-green-border: #d9efdf;
        --percent-green: #2dba63;
        --bar-track: #dff2e4;
        --bar-fill: #2dba63;
        /* Card đỏ (Not Synced) */
        --card-red-bg: #e25757;
        --card-red-text: #ffffff;
        /* Bảng */
        --teal: #7fc4cf;
        --teal-weak: #cfe8eb;
        --row-title: #94a3b8;
        /* Icon tick/x */
        --ok: #2dba63;
        --ng: #e25757;
        /* Tabs */
        --tab-active-bg: #1f2937;
        --tab-active-text: #ffffff;
        --tab-inactive-bg: #f1f5f9;
        --tab-inactive-text: #111827;
        --tab-border: #e2e8f0;
    }

    html, body {
        background: var(--page);
        font-family: 'Inter', 'Segoe UI', Roboto, Arial, sans-serif !important;
    }

    * {
        box-sizing: border-box;
        font-family: Inter,system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial,sans-serif
    }
    .wrap {
        background: #fff;
        max-width: 100%;
        width: 76%;
        margin: 0px auto;
        /* padding: 0 16px; */
        box-shadow: 0 12px 28px rgba(0, 0, 0, .06);
        height: 100%;
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        /* align-items: flex-start; */
        justify-content: flex-start;
    }

    /* ===== 3 THẺ TỔNG QUAN ===== */
    /* .cards {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 100px;
            padding-top:25px
        }*/

    .card {
        border-radius: 18px;
        padding: 1rem 1rem;
        box-shadow: 0 10px 24px rgba(0,0,0,.06);
        width: 32%;
        height:100%;
        display:flex;
        flex-direction:column;
        justify-content:space-around

    }


    .cards {
        /* display: grid
    ; */
        grid-template-columns: 2.5fr 2.5fr 2.5fr;
        gap: 30px;
        padding-top: 25px;
        display: flex;
        padding: 25px 16px;
        width: 100%;
        justify-content: space-between;
        height: 38%
    }

    .card--green {
        background: var(--card-green-bg);
        border: 1px solid var(--card-green-border)
    }

    .card--red {
        background: var(--card-red-bg);
        color: var(--card-red-text)
    }

    .card__title {
        font-weight: 700;
        font-size: 18px;
        margin-bottom: 8px;
        text-align: center;
        color: #1A8939;
    }

    .card__percent {
        font-weight: 600;
        font-size: 48px;
        line-height: 1.05;
        color: var(--percent-green);
        text-align: center;
        color: #1A8939;
    }

    .card__bar {
        height: 8px;
        background: var(--bar-track);
        border-radius: 6px;
        overflow: hidden;
        margin: 10px 0 6px
    }

        .card__bar > i {
            display: block;
            height: 100%;
            background: var(--bar-fill);
            width: 0%
        }

    .card__total {
        font-weight: 700;
        font-size: 14px;
        color: #384B56;
        text-align: center;
        padding-top: 10px
    }


    .card--red .card__title, .card--red .card__total {
        color: var(--card-red-text)
    }

    .card__ns-grid {
        display: flex;
        justify-content: space-around;
        /* gap: 24px; */
        /* margin-top: 2px; */
        margin-bottom: 2rem;
    }

    .card__ns-big {
        font-size: 48px;
        font-weight: 600;
        line-height: 1
    }

    .card__ns-col {
        display: flex;
        flex-direction: column;
        gap: 2px
    }

    .card__ns-num {
        font-size: 28px;
        font-weight: 900;
        line-height: 1
    }

    .card__ns-label {
        font-weight: 600;
        font-size: 25px;
        opacity: .95
    }

    /* ===== Tabs QMH | QSMC ===== */
    .tabs {
        display: flex;
        justify-content: center;
        /*margin-top: 10px*/
        height: 7%
    }

    .tab {
        padding: 8px 18px;
        border: 1px solid var(--tab-border);
        background: var(--tab-inactive-bg);
        color: var(--tab-inactive-text);
        font-weight: 700;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .tab:first-child {
            border-radius: 10px 0 0 10px
        }

        .tab:last-child {
            border-radius: 0 10px 10px 0;
            border-left: none
        }

        .tab.active {
            background: #6092E0;
            color: var(--tab-active-text)
        }



    /* ===== Bảng ma trận ===== */
    .matrix {
        /* background: #fff;*/
        /*  border-radius: 12px;*/
        padding: 16px 18px;
        /* margin-top: 10px;*/
       /* box-shadow: 0 12px 28px rgba(0,0,0,.06);*/
        overflow: auto;
        height: 40%;
        display:flex;
        flex-direction:column;
        justify-content:space-between
            
    }

        .matrix table {
            width: 100%;
            border-collapse: collapse;
            color: #05313c;
            font-weight: 700;
            border-collapse: separate; /* cần thiết để border-radius hoạt động */
            border-spacing: 0;
            border-radius: 10px; /* bo góc 10px */
            overflow: hidden; /* giúp bo góc hiển thị đúng */
            border: 1px solid #ccc; /* viền bảng */
            table-layout: fixed;
          /*  box-shadow: 0 12px 28px rgba(0,0,0,.06);*/
        }

        .matrix thead th {
            color: #263147;
            background: #FAFBFD;
            padding: 10px;
            border: 1px solid #E6E8E9;
            text-align: center;
            height: 10%;
            width: auto
        }

        .matrix tbody th {
            /* background: var(--row-title); */
            background: #f9fafb;
            color: #263147;
            border: 1px solid #E6E8E9;
            height: 10%;
            width: auto
        }

        .matrix td {
            border: 1px solid #E6E8E9;
            height: 10%;
            text-align: center;
            width: auto
        }

            .matrix th:first-child, .matrix td:first-child {
                width: 160px
            }

    th {
        text-align: center;
        width: auto
    }

    /* Icon tick / cross trong bảng */
    .icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        /* width: 60%; */
        /* height: 60%; */
        padding: 0.7rem;
        border-radius: 50%;
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.3);
    }

    .icon_Sm {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: auto;
        border-radius: 50%
    }

    .icon--ok {
        background: var(--ok);
        color: #fff
    }

    .icon--ng {
        background: var(--ng);
        color: #fff
    }

    /* Legend */
    .legend {
        display: flex;
        gap: 5px;
        align-items: center;
        justify-content: center;
        
    }

        .legend i {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: inline-block
        }

        .legend .l-ok {
            background: var(--ok)
        }

        .legend .l-ng {
            background: var(--ng)
        }


    .displayplex {
        margin-right: 20px;
        display: flex;
        height: 30px;
        /*  width: 70px;*/
        align-items: center;
        justify-content: space-between;
        /* justify-items: revert-layer; */
        /* align-content: start; */
    }


   

</style>

<div class="wrap">

    <!-- ===== SUMMARY CARDS ===== -->
    <div class="cards">
        <!-- QSMC Sync -->
        <div class="card card--green">
            <div class="card__title">QSMC Sync Rate</div>
            <div class="card__percent">@syncQSMC%</div>
            <div class="card__bar"><i style="width:@($"{syncQSMC}%")"></i></div>
            <div class="card__total">Total: @Total</div>
        </div>

        <!-- QMH Sync -->
        <div class="card card--green">
            <div class="card__title">QMH Sync Rate</div>
            <div class="card__percent">@syncQMH%</div>
            <div class="card__bar"><i style="width:@($"{syncQMH}%")"></i></div>
            <div class="card__total">Total: @Total</div>
        </div>

        <!-- Not Synced -->
        <div class="card card--red">
            <div class="card__title">Not Synced</div>
            <div class="card__ns-grid">
                @*<div class="card__ns-big">@nsTotal</div>*@

                <div class="card__ns-col">
                    <div class="card__ns-big">@nsQSMC<span style="font-size:15px;font-weight:500">Items</span> </div>
                    <div class="card__ns-label">QSMC</div>
                </div>
                <div class="card__ns-col">
                    <div class="card__ns-big">@nsQMH<span style="font-size:15px;font-weight:500">Items</span></div>
                    <div class="card__ns-label">QMH</div>
                </div>
            </div>
            @*<div class="card__total" style="color: #FFE3DD;font-weight:200;font-size:16px;text-align:center ;margin-top:5px">Items pending across site</div>*@
        </div>
    </div>

    <!-- ===== SWITCH PLANT (tabs) ===== -->
    <div class="tabs">
        <a class="tab @(plant=="QMH" ? "active" : "")" href="@Url.Action("Index","Home", new { plant="QMH" })">QMH</a>
        <a class="tab @(plant=="QSMC" ? "active" : "")" href="@Url.Action("Index","Home", new { plant="QSMC" })">QSMC</a>
    </div>

    <!-- ===== MATRIX ===== -->
    <div class="matrix">
        <table style="height:100%">
            <thead>
                <tr>             
                    <th style="color: #6092E0">@plant</th>
                    @foreach (var c in cols)
                    {
                        <th>@c</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var ln in lines)
                {
                    <tr>
                        <th>@ln</th>
                        @foreach (var dp in cols)
                        {
                            var cell = CellOf(ln, dp);
                            if (cell == null)
                            {
                                <td></td>
                                ; continue;
                            }

                            var pendingUrl = cell.CanClick
                              ? Url.Action("Query", "Page", new { plant = Model.Plant, dep = cell.GroupDep })
                              : "#";

                            <td>
                                @if (cell.CanClick)
                                {
                                    <a href="@pendingUrl" title="@($"{ln} - {dp}")" class="icon @(cell.IsDone ? "icon--ok" : "icon--ng")" aria-label="@($"{ln} - {dp}")">
                                        @Html.Raw(cell.IsDone
                                          ? @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none'><path d='M20 7L9 18l-5-5' stroke='#fff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/></svg>"
                                          : @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none'><path d='M6 6l12 12M18 6L6 18' stroke='#fff' stroke-width='3' stroke-linecap='round'/></svg>")
                                    </a>
                                }
                                else
                                {
                                    <div class="icon @(cell.IsDone ? "icon--ok" : "icon--ng")" aria-disabled="true" title="No permission">
                                        @Html.Raw(cell.IsDone
                                          ? @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none'><path d='M20 7L9 18l-5-5' stroke='#fff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/></svg>"
                                          : @"<svg width='18' height='18' viewBox='0 0 24 24' fill='none'><path d='M6 6l12 12M18 6L6 18' stroke='#fff' stroke-width='3' stroke-linecap='round'/></svg>")
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <!-- Legend -->

    </div>

    <div class="legend " style="height:10%">
        <div class="displayplex" style="width:70px;margin-right:30px;margin-top:20px"> <span class="icon_Sm icon--ok"><svg width='18' height='18' viewBox='0 0 24 24' fill='none'><path d='M20 7L9 18l-5-5' stroke='#fff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' /></svg></span> <span>Synced</span></div>
        <div class="displayplex" style="width: 100px; margin-top: 20px">  <span class="icon_Sm icon--ng"><svg width='18' height='18' viewBox='0 0 24 24' fill='none'><path d='M6 6l12 12M18 6L6 18' stroke='#fff' stroke-width='3' stroke-linecap='round' /></svg></span>  <span>Not Synced</span></div>

    </div>

</div>
