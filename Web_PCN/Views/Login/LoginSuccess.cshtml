@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    ViewBag.Title = "Welcome";
    var next = (string)(ViewBag.NextUrl ?? Url.Action("Index", "Home"));
    var user = (string)(ViewBag.UserName ?? "User");
}

@section Styles{
    <style>
        /* ===== Brighter, softer look ===== */
        .splash-wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(900px 450px at -10% -10%, rgba(59,130,246,.18) 0, rgba(59,130,246,0) 60%), radial-gradient(900px 450px at 120% 120%, rgba(34,197,94,.16) 0, rgba(34,197,94,0) 60%), linear-gradient(135deg,#eaf3ff,#f7fbff);
        }

        .splash-card {
            width: 440px;
            max-width: 92vw;
            background: rgba(255,255,255,.88);
            border: 1px solid rgba(17,24,39,.08);
            border-radius: 20px;
            backdrop-filter: blur(8px);
            padding: 36px 28px;
            color: #0f172a;
            text-align: center;
            box-shadow: 0 18px 50px rgba(15,23,42,.12);
            position: relative;
            overflow: hidden;
        }

        /* ===== Badge: ring + check, perfectly centered ===== */
        .badge {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 6px auto 16px;
            display: grid;
            place-items: center;
        }

        .ring {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: radial-gradient(closest-side,#a5e8ff,#93c5fd 60%,transparent 70%);
            filter: blur(8px);
            opacity: .55;
            transform: scale(.9);
            animation: ringPulse 2.6s ease-in-out infinite;
        }

        @@keyframes ringPulse {
            0%, 100% {
                opacity: .45;
                transform: scale(.88);
            }

            50% {
                opacity: .65;
                transform: scale(1);
            }
        }

        .check {
            width: 84px;
            height: 84px;
            display: block;
        }

            .check circle {
                fill: #ffffff;
                stroke: #3b82f6;
                stroke-width: 8;
                filter: drop-shadow(0 3px 10px rgba(59,130,246,.28));
                stroke-dasharray: 472;
                stroke-dashoffset: 472;
                animation: draw 1000ms ease forwards 300ms;
            }

            .check path {
                stroke: #10b981;
                stroke-width: 10;
                fill: none;
                stroke-linecap: round;
                stroke-linejoin: round;
                stroke-dasharray: 120;
                stroke-dashoffset: 120;
                animation: draw 900ms cubic-bezier(.2,.9,.2,1) forwards 1000ms;
                filter: drop-shadow(0 4px 10px rgba(16,185,129,.28));
            }

        @@keyframes draw {
            to {
                stroke-dashoffset: 0;
            }
        }

        .title {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: .3px;
            margin-top: 6px;
            color: #0b1220;
        }

        .sub {
            opacity: .85;
            color: #1f2937;
        }

        .progress-wrap {
            height: 6px;
            background: rgba(15,23,42,.08);
            border-radius: 999px;
            margin-top: 22px;
            overflow: hidden;
        }

        .bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg,#a5f3fc,#93c5fd);
            animation: load 2.8s ease-in forwards;
        }

        @@keyframes load {
            from {
                width: 0%
            }

            to {
                width: 100%
            }
        }

        .confetti {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: visible;
        }

            .confetti i {
                position: absolute;
                width: 8px;
                height: 14px;
                opacity: 0;
                transform: translateY(-20px) rotate(0deg);
                animation: fall var(--dur, 2000ms) cubic-bezier(.2,.7,.2,1) forwards;
                filter: saturate(.9) brightness(1.05);
            }

        @@keyframes fall {
            0% {
                opacity: 0;
                transform: translateY(-20px) rotate(0deg);
            }

            10% {
                opacity: 1;
            }

            100% {
                opacity: 0;
                transform: translateY(520px) rotate(540deg);
            }
        }

        @@media (prefers-color-scheme: dark) {
            .splash-wrap {
                background: radial-gradient(900px 450px at -10% -10%, rgba(59,130,246,.28) 0, rgba(59,130,246,0) 60%), radial-gradient(900px 450px at 120% 120%, rgba(34,197,94,.24) 0, rgba(34,197,94,0) 60%), linear-gradient(135deg,#0f1b2d,#0f2036);
            }

            .splash-card {
                background: rgba(255,255,255,.08);
                color: #eaf0f6;
                box-shadow: 0 24px 80px rgba(0,0,0,.35);
                border-color: rgba(255,255,255,.12);
            }

            .title {
                color: #f3f7ff;
            }

            .sub {
                color: #e5efff;
                opacity: .85;
            }

            .progress-wrap {
                background: rgba(255,255,255,.18);
            }
        }
    </style>
}

<section class="splash-wrap">
    <div class="splash-card">

        <!-- Badge: ring + check (centered) -->
        <div class="badge">
            <div class="ring" aria-hidden="true"></div>

            <!-- Check SVG -->
            <svg class="check" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                <circle cx="60" cy="60" r="44"></circle>
                <path d="M40 62 L56 76 L82 46"></path>
            </svg>
        </div>

        <div class="title">Welcome, @user!</div>
        <div class="sub">Login successful. Redirecting to your dashboard…</div>

        <div class="progress-wrap"><div class="bar"></div></div>

        <div class="confetti" id="confetti"></div>
    </div>
</section>

@section scripts{
    <script>
  // Confetti generator (lightweight, no lib)
  (function(){
    const area = document.getElementById('confetti');
    const colors = ['#22d3ee','#3b82f6','#34d399','#f59e0b','#ef4444','#a78bfa'];
    const pieces = 56;
    for(let i=0;i<pieces;i++){
      const p = document.createElement('i');
      p.style.left = (Math.random()*100) + '%';
      p.style.top = (-Math.random()*80) + 'px';
      p.style.background = colors[i % colors.length];
      p.style.animationDelay = (Math.random()*200) + 'ms';
      p.style.setProperty('--dur', (400 + Math.random()*400) + 'ms');
      p.style.borderRadius = (Math.random()>.5?2:999)+'px';
      area.appendChild(p);
    }
  })();

  // Redirect (giữ như cũ)
  setTimeout(function(){
    window.location.href = '@next';
  }, 500);
    </script>
}