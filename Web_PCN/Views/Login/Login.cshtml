@using Web_PCN.Models.ViewModels
@model LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    ViewBag.Title = "Đăng nhập";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --page-1: #eaf3ff;
            --page-2: #f4f7fb;
            --card: #ffffff;
            --shadow: 0 30px 80px rgba(17,24,39,.18);
            --line: rgba(17,24,39,.06);
            --text: #111827;
            --muted: #6b7280;
            --primary: #111827;
            --link: #145cf4;
            --input-bg: #f7f9fc;
            --radius-lg: 22px;
            --radius-sm: 12px;
        }

        .pcn-login, .pcn-login * {
            box-sizing: border-box;
        }

        .pcn-login {
            min-height: 100vh;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px 24px;
            font-family: 'Inter','Segoe UI',Roboto,Arial,sans-serif;
            color: var(--text);
            background: radial-gradient(1200px 800px at 20% 0%, var(--page-1), var(--page-2));
        }

            .pcn-login .wrap {
                width: 100%;
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            /* CARD: không fixed để không cắt phần minh hoạ bên phải */
            .pcn-login .card {
                width: 100%;
                max-width: 960px;
                background: var(--card);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow);
                position: relative;
                overflow: visible; /* cho phép blob tràn ra */
            }

            .pcn-login .content {
                position: relative;
                z-index: 1;
                display: grid;
                grid-template-columns: 1.1fr 0.9fr;
                gap: 48px;
                padding: 48px;
            }

        @@media (max-width:920px) {
            .pcn-login .content {
                grid-template-columns: 1fr;
                gap: 28px;
                padding: 28px;
            }
        }

        /* Brand */
        .pcn-login .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

            .pcn-login .brand .title {
                font-size: 28px;
                font-weight: 700;
                letter-spacing: .2px;
            }
        /* Logo = ảnh */
        .pcn-login .logo-img {
            width: 50px;
            height: 50px;
            /* display:inline-block; */
            object-fit: cover;
            /* box-shadow:0 2px 6px rgba(0,0,0,.06);*/
        }

        /* Field */
        .pcn-login .field {
            margin-bottom: 16px;
        }

        .pcn-login .label {
            display: block;
            font-weight: 600;
            font-size: .92rem;
            margin: 0 0 6px 2px;
            color: #1f2937;
        }

        .pcn-login .control {
            position: relative;
            background: var(--input-bg);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            padding: 10px 14px 10px 50px;
            height: 50px;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }

            .pcn-login .control input {
                width: 100%;
                height: 100%;
                border: 0;
                outline: 0;
                background: transparent;
                font-size: 15px;
                color: var(--text);
            }

            .pcn-login .control:focus-within {
                border-color: #9db8ff;
                box-shadow: 0 0 0 4px rgba(20,92,244,.12);
                background: #fff;
            }

        /* Icon SVG bên trái trong input (TO: to hơn chút) */
        .pcn-login .icon-left {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 22px;
            height: 22px;
            color: #9aa3b2; /* giữ màu xám nhạt */
            flex: 0 0 auto;
        }

        /* Nút mắt trong ô mật khẩu (giữ SVG sprite) */
        .pcn-login .eye-btn {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            cursor: pointer;
        }

            .pcn-login .eye-btn:hover {
                background: #eef2f7;
            }

            .pcn-login .eye-btn .icon {
                width: 22px;
                height: 22px;
            }

        /* Actions */
        .pcn-login .actions {
            margin-top: 18px;
        }

        .pcn-login .btn {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 50px;
            border-radius: 14px;
            border: 0;
            cursor: pointer;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: .2px;
            background: var(--primary);
            color: #fff;
            box-shadow: 0 12px 30px rgba(0,0,0,.18);
            transition: transform .06s ease, box-shadow .2s ease;
        }

            .pcn-login .btn:active {
                transform: translateY(1px);
                box-shadow: 0 10px 24px rgba(0,0,0,.20);
            }

        .pcn-login .links {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 14px;
            font-size: .95rem;
        }

            .pcn-login .links a {
                color: var(--link);
                text-decoration: none;
            }

                .pcn-login .links a:hover {
                    text-decoration: underline;
                }

        /* Illustration: blob dưới, paper trên */
        .pcn-login .illu {
            position: relative;
            min-height: 260px;
            display: flex;
            align-items: center;
            justify-content: center;
            isolation: isolate;
        }

            .pcn-login .illu::before {
                content: "";
                position: absolute;
                inset: auto -80px auto auto;
                width: 420px;
                height: 420px;
                border-radius: 40px;
                z-index: 0;
                background: radial-gradient(300px 260px at 40% 40%, #edf2ff 0%, #f7f9ff 60%, transparent 61%);
            }

        .pcn-login .paper {
            position: relative;
            z-index: 1;
            width: 240px;
            height: 200px;
            border-radius: 18px;
            background: #fff;
            border: 1px solid var(--line);
            box-shadow: 0 12px 30px rgba(17,24,39,.08);
        }

            .pcn-login .paper:before {
                content: "";
                position: absolute;
                right: 0;
                bottom: 0;
                width: 56px;
                height: 56px;
                border-top-left-radius: 12px;
                background: linear-gradient(135deg,#eaf1ff,#cfe0ff);
                clip-path: polygon(0 0,100% 0,100% 100%);
            }

            .pcn-login .paper .tick {
                position: absolute;
                left: 22px;
                top: 20px;
                color: #2ea66b;
                width: 28px;
                height: 28px;
            }

        .pcn-login .line {
            position: absolute;
            left: 22px;
            right: 22px;
            height: 10px;
            border-radius: 6px;
            background: #eef2f7;
        }

        .pcn-login .l1 {
            top: 64px;
        }

        .pcn-login .l2 {
            top: 84px;
        }

        .pcn-login .l3 {
            top: 104px;
            width: 70%;
        }

        /* Validation summary */
        .pcn-login .validation-summary-errors {
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: #7f1d1d;
            border-radius: 12px;
            padding: 10px 14px;
        }

        /* Footer riêng của view */
        .pcn-login .footer {
            margin-top: 24px;
            color: var(--muted);
            font-size: .95rem;
            text-align: center;
        }
    </style>
}

<section class="pcn-login">
    <div class="wrap">
        <!-- CARD -->
        <div class="card">
            <div class="content">
                <!-- Form -->
                <div>
                    <div class="brand">
                        <!-- Logo ảnh -->
                        <img class="logo-img" src="@Url.Content("~/Content/images/quanta_logo.png")" alt="Logo" />
                        <div class="title">Process Change Notice</div>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors mb-3" })

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm", autocomplete = "off" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Username -->
                        <div class="field">
                            <label class="label" for="Login">Username</label>
                            <div class="control">
                                <!-- GIỮ ICON SVG SPRITE, to hơn chút -->
                                <svg class="icon-left" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-5 0-9 2.5-9 5.5A1.5 1.5 0 0 0 4.5 21h15A1.5 1.5 0 0 0 21 19.5C21 16.5 17 14 12 14Z" />
                                </svg>
                                @Html.TextBoxFor(m => m.Login, new
                                {
                                    @id = "Login",
                                    placeholder = "Enter your username",
                                    autocomplete = "username"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Login, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Password -->
                        <div class="field">
                            <label class="label" for="pwd">Password</label>
                            <div class="control">
                                <!-- GIỮ ICON SVG SPRITE, to hơn chút -->
                                <svg class="icon-left" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M17 9h-1V7a4 4 0 1 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Zm-6 0V7a3 3 0 0 1 6 0v2Zm3 7a1.5 1.5 0 1 1 1.5-1.5A1.5 1.5 0 0 1 14 16Z" />
                                </svg>
                                @Html.PasswordFor(m => m.Password, new
                                {
                                    @id = "pwd",
                                    placeholder = "Enter your password",
                                    autocomplete = "current-password"
                                })
                                <!-- Nút mắt dùng SVG sprite -->
                                <button type="button" class="eye-btn" tabindex="-1" aria-label="Show/Hide password" onclick="togglePwd()">
                                    <svg id="eye" class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <!-- mặc định là eye-slash -->
                                        <path d="M12 5C7 5 2.73 8.11 1 12c.63 1.4 1.62 2.64 2.81 3.67l1.42-1.42A8.91 8.91 0 0 1 3.35 12C4.93 9 8.2 7 12 7c1.19 0 2.33.2 3.38.58l1.66-1.66C15.8 5.34 13.97 5 12 5Zm9 7c-.39.86-.94 1.66-1.6 2.37l1.41 1.41A12.53 12.53 0 0 0 23 12c-1.73-3.89-6-7-11-7-.9 0-1.78.09-2.63.26l1.77 1.77c.28-.02.57-.03.86-.03 3.8 0 7.07 2 8.65 5ZM2.1 2.1 1 3.21l3.2 3.2C2.8 7.6 1.5 9.69 1 12c1.73 3.89 6 7 11 7 2.02 0 3.93-.42 5.61-1.17l3.18 3.18 1.11-1.11L2.1 2.1ZM12 17c-3.8 0-7.07-2-8.65-5 .58-1.12 1.39-2.11 2.35-2.92l1.56 1.56A5 5 0 0 0 12 17Zm0-8a5 5 0 0 0-4.24 2.34l1.53 1.53A3 3 0 0 1 15 12c0-.33-.05-.64-.14-.94l1.7-1.7A5 5 0 0 0 12 9Z" />
                                    </svg>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Remember + Forgot -->
                        <div class="links">
                            <label style="display:flex; align-items:center; gap:8px;">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @id = "remember" })
                                <span>Remember me</span>
                            </label>
                            <a href="#">Forgot password?</a>
                        </div>

                        <!-- Submit -->
                        <div class="actions">
                            <button class="btn" type="submit" id="btnLogin">
                                <span>Log in</span>
                                <span class="spinner-border spinner-border-sm d-none" id="spin" role="status" aria-hidden="true" style="margin-left:10px;"></span>
                            </button>
                        </div>
                    }
                </div>

                <!-- Illustration -->
                <div class="illu" aria-hidden="true">
                    <div class="paper">
                        <svg class="tick" viewBox="0 0 24 24" fill="currentColor" width="28" height="28" aria-hidden="true">
                            <path d="M20.3 7.3a1 1 0 0 0-1.4-1.4L10 14.8 5.1 9.9a1 1 0 1 0-1.4 1.4l5.9 5.9a1 1 0 0 0 1.4 0l9.3-9.9z" />
                        </svg>
                        <span class="line l1"></span>
                        <span class="line l2"></span>
                        <span class="line l3"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">Copyright © QMH QMS</div>
    </div>
</section>

@section scripts{
    <script>
        function togglePwd() {
            const pwd = document.getElementById('pwd');
            const eye = document.getElementById('eye');
            if (!pwd || !eye) return;

            // Đổi giữa "eye" và "eye-slash" bằng cách thay path SVG
            const toEye = `<path d="M12 5c5 0 9.27 3.11 11 7-1.73 3.89-6 7-11 7S2.73 15.89 1 12c1.73-3.89 6-7 11-7Zm0 4a4 4 0 1 0 4 4 4 4 0 0 0-4-4Zm0 2a2 2 0 1 1-2 2 2 2 0 0 1 2-2Z"/>`;
            const toEyeSlash = `<path d="M12 5C7 5 2.73 8.11 1 12c.63 1.4 1.62 2.64 2.81 3.67l1.42-1.42A8.91 8.91 0 0 1 3.35 12C4.93 9 8.2 7 12 7c1.19 0 2.33.2 3.38.58l1.66-1.66C15.8 5.34 13.97 5 12 5Zm9 7c-.39.86-.94 1.66-1.6 2.37l1.41 1.41A12.53 12.53 0 0 0 23 12c-1.73-3.89-6-7-11-7-.9 0-1.78.09-2.63.26l1.77 1.77c.28-.02.57-.03.86-.03 3.8 0 7.07 2 8.65 5ZM2.1 2.1 1 3.21l3.2 3.2C2.8 7.6 1.5 9.69 1 12c1.73 3.89 6 7 11 7 2.02 0 3.93-.42 5.61-1.17l3.18 3.18 1.11-1.11L2.1 2.1ZM12 17c-3.8 0-7.07-2-8.65-5 .58-1.12 1.39-2.11 2.35-2.92l1.56 1.56A5 5 0 0 0 12 17Zm0-8a5 5 0 0 0-4.24 2.34l1.53 1.53A3 3 0 0 1 15 12c0-.33-.05-.64-.14-.94l1.7-1.7A5 5 0 0 0 12 9Z"/>`;

            if (pwd.type === 'password') {
                pwd.type = 'text';
                eye.innerHTML = toEye;      // đổi sang eye
            } else {
                pwd.type = 'password';
                eye.innerHTML = toEyeSlash; // đổi lại eye-slash
            }
        }
        document.getElementById('loginForm')?.addEventListener('submit', function () {
            document.getElementById('spin')?.classList.remove('d-none');
            document.getElementById('btnLogin')?.setAttribute('disabled', 'disabled');
        });
    </script>
}
