@using Web_PCN.Models.ViewModels
@model LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
    ViewBag.Title = "Đăng nhập";
}

@section Styles {
    <link rel="stylesheet" href="~/Content/Site_login.css" />
    <style>
        /* ====== FORCE OVERRIDES — ƯU TIÊN CAO NHẤT CHO VIEW NÀY ====== */

        /* 1) Icon size (phòng trường hợp có rule svg {width:100%}) */
        svg.icon {
            width: 18px !important;
            height: 18px !important;
            display: inline-block !important;
            vertical-align: -0.125em !important;
            flex: 0 0 auto !important;
        }

        .list-unstyled svg.icon {
            width: 20px !important;
            height: 20px !important;
        }

        .brand-badge svg.icon {
            width: 28px !important;
            height: 28px !important;
        }

        .brand-badge-sm svg.icon {
            width: 24px !important;
            height: 24px !important;
        }

        .input-group-text {
            padding-left: 12px;
            padding-right: 12px;
        }

        /* 2) Nút LOGIN: đè tuyệt đối mọi rule khiến nền/opacity bị mất  */
        #btnLogin {
            background: #2563eb !important; /* nền rõ */
            color: #fff !important; /* chữ trắng */
            border: 1px solid #2563eb !important;
            opacity: 1 !important;
            filter: none !important; /* không mờ */
            box-shadow: none !important;
            pointer-events: auto !important;
        }

            #btnLogin:hover {
                background: #1f55e0 !important;
                border-color: #1f55e0 !important;
            }

            #btnLogin:active {
                background: #1849c4 !important;
                border-color: #1849c4 !important;
            }

            #btnLogin:disabled {
                background: #2563eb !important;
                border-color: #2563eb !important;
                color: #fff !important;
                opacity: .65 !important; /* chỉ mờ khi disable thật */
            }

        /* 3) Chặn mọi rule reset “.btn { background:transparent }” ở cấp cao hơn */
        .btn, .btn-primary {
            background-clip: border-box !important;
        }
    </style>
}

<section class="min-vh-100 d-flex align-items-center bg-auth">
    <div class="container">
        <div class="row g-0 shadow-lg rounded-4 overflow-hidden auth-wrapper mx-auto">
            <!-- LEFT -->
            <div class="col-lg-6 d-none d-lg-block auth-left">
                <div class="p-5">
                    <div class="d-flex align-items-center mb-4">
                        <div class="brand-badge me-3">
                            <svg class="icon text-white" width="28" height="28"><use href="#i-laptop" /></svg>
                        </div>
                        <div>
                            <h4 class="mb-0 text-white">Quanta PCN</h4>
                            <div class="text-white-50 small">Process Change Notice System</div>
                        </div>
                    </div>

                    <h2 class="text-white fw-semibold lh-sm mb-3">PROCESS CHANGE NOTICE</h2>
                    <ul class="list-unstyled text-white-50 mt-4 mb-0">
                        <li class="mb-2">
                            <svg class="icon me-2 text-success" width="20" height="20"><use href="#i-check2-circle" /></svg>
                            PE/TE/AME/EQ/ME...
                        </li>
                        <li class="mb-2">
                            <svg class="icon me-2 text-success" width="20" height="20"><use href="#i-check2-circle" /></svg>
                            Synchronization between departments
                        </li>
                    </ul>
                </div>
            </div>

            <!-- RIGHT -->
            <div class="col-lg-6 bg-white p-4 p-md-5">
                <div class="text-center mb-4 d-lg-none">
                    <div class="brand-badge brand-badge-sm mb-2">
                        <svg class="icon text-white" width="24" height="24"><use href="#i-laptop" /></svg>
                    </div>
                    <h4 class="fw-bold mb-0">Quanta PCN</h4>
                    <div class="text-muted small">SOP Information Page</div>
                </div>

                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm", autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- Login -->
                    <div class="mb-3">
                        <label class="form-label">User Name</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <svg class="icon" width="18" height="18"><use href="#i-person" /></svg>
                            </span>
                            @Html.TextBoxFor(m => m.Login, new
                            {
                                @class = "form-control",
                                placeholder = "User_id / fullname / email",
                                autocomplete = "username",
                                inputmode = "text"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Login, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <svg class="icon" width="18" height="18"><use href="#i-shield-lock" /></svg>
                            </span>
                            @Html.PasswordFor(m => m.Password, new
                            {
                                @class = "form-control",
                                placeholder = "••••••••",
                                autocomplete = "current-password",
                                id = "pwd"
                            })
                            <button type="button" class="btn btn-outline-secondary" tabindex="-1"
                                    aria-label="Hiện/ẩn mật khẩu" onclick="togglePwd()">
                                <svg id="eye" class="icon" width="18" height="18"><use href="#i-eye-slash" /></svg>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Remember / Forgot -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "remember" })
                            <label class="form-check-label" for="remember">Remember</label>
                        </div>
                        <a href="#" class="small text-decoration-none">Forget?</a>
                    </div>

                    <!-- Submit -->
                    <button class="btn btn-primary btn-lg w-100 d-flex align-items-center justify-content-center gap-2"
                            type="submit" id="btnLogin"
                            style="background:#2563eb!important;color:#fff!important;border:1px solid #2563eb!important;
                               opacity:1!important;filter:none!important;box-shadow:none!important;">
                        <span>Login</span>
                        <span class="spinner-border spinner-border-sm d-none" id="spin" role="status" aria-hidden="true"></span>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@section scripts{
    <script>
        function togglePwd() {
            const eye = document.getElementById('eye');
            const pwd = document.getElementById('pwd');
            if (!pwd || !eye) return;
            const use = eye.querySelector('use');
            if (pwd.type === 'password') { pwd.type = 'text'; use.setAttribute('href', '#i-eye'); }
            else { pwd.type = 'password'; use.setAttribute('href', '#i-eye-slash'); }
        }
        document.getElementById('loginForm')?.addEventListener('submit', function () {
            document.getElementById('spin')?.classList.remove('d-none');
            document.getElementById('btnLogin')?.setAttribute('disabled', 'disabled');
        });
    </script>
}
