@model Core.Dtos.QueryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* --- form: 2 cột --- */
    .form-grid {
        display: flex;
        /*  grid-template-columns: repeat(2,1fr);*/
        gap: 16px 20px;
        margin-bottom: 16px;
        height: 90%;
        justify-content: flex-start
    }

    .form-group label {
        font-weight: 600;
        font-size: 13px;
        color: #374151;
        margin-bottom: 6px
    }

    .form-group select,
    .form-group input[type=text] {
        height: 38px;
        padding: 6px 10px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        background: #f9fafb;
        color: #111827;
        font-size: 13px;
        transition: .2s
    }

        .form-group select:focus,
        .form-group input[type=text]:focus {
            outline: none;
            background: #fff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,.2)
        }

    .form-actions {
        display: flex;
        justify-content: flex-start;
        margin-top: 8px
    }
    /* --- empty state --- */
    .empty {
        border: 1px dashed #cfd6e5;
        border-radius: 10px;
        background: #f8fafc;
        padding: 28px;
        text-align: center;
        color: #64748b
    }

        .empty .emoji {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #e0e7ff;
            margin-bottom: 10px;
            font-size: 24px;
            color: #3949ab
        }

        .empty h5 {
            margin: 6px 0 4px;
            font-weight: 700;
            color: #334155
        }

        .empty p {
            margin: 0
        }

    .form-group {
        margin-bottom: 15px;
        width: 30% !important;
    }

    .btn-primary {
        color: #fff;
        background-color: #337ab7;
        border-color: #2e6da4;
        margin-right: 30px;
    }


    .panel-default {
        border-color: #ddd;
        width: 76%;
        margin: auto;
        /* min-height: 78vh; */
       overflow-y: auto;
        height: 78vh;
    }
   /* .table {
        overflow-y: auto;
        height: 57vh;
    }*/

  
</style>
<div class="panel panel-default">
    <div class="panel-heading"><strong>View Change Request</strong></div>
    <div class="panel-body">
        @using (Html.BeginForm("Query", "Page", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @* giữ ngữ cảnh menu *@
            @Html.HiddenFor(m => m.ParentName)
            @Html.HiddenFor(m => m.ChildName)
            @Html.HiddenFor(m => m.ParentId)
            @Html.HiddenFor(m => m.ChildId)
            @Html.HiddenFor(m => m.DepCode)
            @Html.HiddenFor(m => m.Plant)
            <div class="form-grid">
                <div class="form-group">
                    <label>Category</label>
                    @Html.DropDownListFor(m => m.Category,
                                  Model.CategoryList ?? Enumerable.Empty<System.Web.Mvc.SelectListItem>(),
                                  "-- All categories --",
                                  new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <label>Status</label>
                    @Html.DropDownListFor(m => m.Status,
                    Model.StatusList ?? Enumerable.Empty<System.Web.Mvc.SelectListItem>(),
                    "-- All Status --",
                    new { @class = "form-control" })
                </div>
                @*<div class="form-group">
                    <label>Document code</label>
                    @Html.TextBoxFor(m => m.DocumentCode, new { @class = "form-control", placeholder = "Enter document code..." })
                </div>*@
                <div class="form-group">
                    <label>Change title</label>
                    @Html.TextBoxFor(m => m.ChangeTitle, new { @class = "form-control", placeholder = "Enter change title..." })
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Query</button>
                <button formaction="@Url.Action("Download","Page")" formmethod="post" class="btn btn-default">Download</button>
            </div>
        }
        <hr />
        @if (Model.Results != null && Model.Results.Any())
        {
            <table class="table table-bordered table-hover table-condensed">
                <thead>
                    <tr class="info">
                        <th>Change title</th>

                        <th>Category</th>
                        <th style="width:50px;">Version</th>
                        <th style="width:50px;">Model</th>
                        <th style="width:100px;">Department</th>
                        <th style="width:50px;">Factory</th>
                        <th style="width: 130px;">Status</th>
                        <th style="width: 90px;">TransDateTime</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Results)
                    {
                        <tr>

                            <td>
                                <a href="@Url.Action("ChangeRequestDetail","ChangeRequest",
                                       new { requestid = r.RequestID, dep_c = r.Department })">
                                    @r.ChangeTitle
                                </a>
                            </td>
                            <td>@r.Category</td>
                            <td style=" text-align: center">@r.Version</td>
                            <td>@r.Model</td>
                            <td>@r.Department</td>
                            <td>@r.Factory</td>
                            <td style="color: #a94442">@r.Status</td>
                            <td>@r.TransDateTime</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty">
                @*<div class="emoji">🗂️</div>*@
                <h5>No data found</h5>

            </div>
        }
    </div>
</div>