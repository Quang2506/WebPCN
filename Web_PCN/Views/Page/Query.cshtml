@model Core.Dtos.QueryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var parent = Model.ParentName;
    var child = Model.ChildName;
}

<div class="panel panel-default">
    <div class="panel-heading"><strong>View Change Request</strong></div>
    <div class="panel-body">
        @using (Html.BeginForm("Query", "Page", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ParentName)
            @Html.HiddenFor(m => m.ChildName)

            <div class="form-group">
                <label class="col-sm-2 control-label">Category:</label>
                <div class="col-sm-4">
                    @Html.TextBoxFor(m => m.Category, new { @class = "form-control" })
                </div>

                <label class="col-sm-2 control-label">Status</label>
                <div class="col-sm-4">
                    @Html.TextBoxFor(m => m.Status, new { @class = "form-control" })
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label">Document code:</label>
                <div class="col-sm-4">
                    @Html.TextBoxFor(m => m.DocumentCode, new { @class = "form-control" })
                </div>

                <label class="col-sm-2 control-label">Changes title:</label>
                <div class="col-sm-4">
                    @Html.TextBoxFor(m => m.ChangeTitle, new { @class = "form-control" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-6">
                    <button type="submit" class="btn btn-primary">Query</button>
                </div>
                <div class="col-sm-6 text-right">
                    <button formaction="@Url.Action("Download","Page")" formmethod="post"
                            class="btn btn-default">
                        Download
                    </button>
                </div>
            </div>
        }

        <hr />

        @if (Model.Results != null && Model.Results.Any())
        {
            <table class="table table-bordered table-hover table-condensed">
                <thead>
                    <tr class="info">
                        <th style="width:160px;">Code</th>
                        <th style="width:90px;">Version</th>
                        <th>Change title</th>
                        <th style="width:150px;">Department</th>
                        <th style="width:150px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Results)
                    {
                        <tr>
                            <td><a href="#">@r.Code</a></td>
                            <td>@r.Version</td>
                            <td class="text-danger">@r.ChangeTitle</td>
                            <td>@r.Department</td>
                            <td class="text-danger">@r.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-muted">No data.</div>
        }
    </div>
</div>
